{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "DynamoDb": {
    "ServiceUrl": "http://localhost:8000",
    "Region": "us-east-1",
    "CreateTableIfMissing": true
  },

  "ZoneSyncApi": {
    "Token": "dev-zone-sync-token"
  },

  "Delegation": {
    "Enabled": false
  }
}
