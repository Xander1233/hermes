# Copy to `.env` and fill in. Everything here is baked into the client bundle at build
# time — never put a secret in a VITE_ variable.

# --- API ---------------------------------------------------------------------------------
# `true` serves every request from the in-memory mock in app/lib/api/mock.ts.
# Flip to `false` once the management backend is reachable.
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=http://localhost:5080/api/v1

# --- AWS Cognito -------------------------------------------------------------------------
# The app client must be a PUBLIC client (no secret) with the authorization-code grant
# enabled, and both URLs below registered as callback / sign-out URLs.
VITE_COGNITO_REGION=eu-central-1
VITE_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=your-prefix.auth.eu-central-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/login
VITE_COGNITO_SCOPES=openid email profile
