{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Cognito configuration for AWS Cognito authentication.
  // Replace the placeholders with your actual Cognito User Pool ID and App Client ID.
  // Must match the VITE_COGNITO_* environment variables in /frontend
  "Cognito": {
    "Region": "eu-central-1",
    "UserPoolId": "eu-central-1_xxxxx",
    "ClientId": "<Cognito App Client ID>"
  },

  // Configuration for the communication from the /dns instances to the management backend.
  // Hardcoded token that must match the configuration in /dns instances
  "ZoneSyncApi": {
    "Token": "Test123"
  },

  "Cors": {
    "AllowedOrigins": ["*"]
  },

  "DynamoDb": {
    "TableName": "hermes-dns",
    "Region": "eu-central-1",
    "ServiceUrl": null,
    "CreateTableIfMissing": false
  },

  // Cache configuration for the management backend. Can be set to "None" or "Redis".
  // The cache sits between the /dns instances and the management backend, caching zone data to reduce load on the management backend.
  // Zone entries are automatically invalidated when a zone is updated or after the configured TTL expires.
  // Dashboard always shows the latest data, bypassing the cache.
  "Cache": {
    "Provider": "None",
    "RedisConnectionString": null,
    "TtlSeconds": 10,
    "InstanceName": "hermes-mgmt:"
  },

  // Default values for newly created zones. Can be overridden per zone.
  "ZoneDefaults": {
    "Nameservers": ["ns1.hermes-dns.net", "ns2.hermes-dns.net"],
    "SoaMname": null,
    "SoaRnamePrefix": "hostmaster",
    "Refresh": 3600,
    "Retry": 600,
    "Expire": 604800,
    "Minimum": 60,
    "SoaTtl": 3600,
    "MaxZonesPerUser": 50,
    "MaxRecordsPerZone": 1000
  },

  // Configuration for the push updates from the management backend to the /dns instances.
  "HermesFleet": {
    "AdminEndpoints": ["http://127.0.0.1:8080"],
    "AdminToken": "Test_Token", // Must be the same as in /dns/config/server.toml
    "TimeoutMs": 3000
  },

  // Configuration for the delegation resolver that is used to check for domain delegation.
  "Delegation": {
    "Enabled": true,
    "Resolvers": [ "1.1.1.1", "1.0.0.1", "8.8.8.8", "8.8.4.4" ],
    "TimeoutMs": 3000,
    "MonitorEnabled": true,
    "ScanIntervalSeconds": 60,
    "BatchSize": 50
  }
}
